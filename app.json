{
  "expo": {
    "name": "Griyaku",
    "slug": "griyaku",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "griyaku",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.griyaku.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E8F7E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "id.griyaku.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E8F7E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Griyaku perlu akses galeri untuk menambahkan foto ke iklan properti Anda.",
          "cameraPermission": "Griyaku perlu akses kamera untuk memotret properti yang Anda iklankan."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Griyaku memakai lokasi Anda untuk menandai lokasi properti dan menampilkan properti terdekat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E8F7E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}